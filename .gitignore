puredent-admin/*.freezed.dart
puredent-admin/.fvm/
puredent-admin/.flutter-plugins
puredent-admin/.flutter-plugins-dependencies
puredent-admin/.flutter-versions

# Build Outputs & Obfuscation
puredent-admin/app.*.symbols
puredent-admin/app.*.map.json

# Android
puredent-admin/android/app/debug/
puredent-admin/android/app/profile/
puredent-admin/android/app/release/
