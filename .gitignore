# Desktop & Web Plugins
puredent-admin/**/GeneratedPluginRegistrant.*
puredent-admin/macos/Flutter/GeneratedPluginRegistrant.swift
puredent-admin/macos/Flutter/ephemeral/
puredent-admin/linux/flutter/generated_plugin_registrant.cc
puredent-admin/linux/flutter/generated_plugin_registrant.h
puredent-admin/linux/flutter/generated_plugins.cmake
puredent-admin/windows/flutter/generated_plugin_registrant.cc
puredent-admin/windows/flutter/generated_plugin_registrant.h
puredent-admin/windows/flutter/generated_plugins.cmake
puredent-admin/web/.dart_tool/

# Secrets & Environment
puredent-admin/.env
puredent-admin/.env.local
puredent-admin/*.env

# Exceptions
!puredent-admin/**/ios/**/default.mode1v3
!puredent-admin/**/ios/**/default.mode2v3
!puredent-admin/**/ios/**/default.pbxuser
!puredent-admin/**/ios/**/default.perspectivev3
!puredent-admin/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages


