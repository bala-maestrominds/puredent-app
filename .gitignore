puredent-admin/android/gradlew.bat
puredent-admin/android/local.properties
puredent-admin/android/**/GeneratedPluginRegistrant.java
puredent-admin/android/key.properties
puredent-admin/**/*.keystore
puredent-admin/**/*.jks

# iOS
puredent-admin/ios/**/*.mode1v3
puredent-admin/ios/**/*.mode2v3
puredent-admin/ios/**/*.moved-aside
puredent-admin/ios/**/*.pbxuser
puredent-admin/ios/**/*.perspectivev3
